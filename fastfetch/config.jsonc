{
    "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.70.0/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "printf '\\033[36m%s\\n' '           /\\' '          /  \\' '         /    \\' '        /      \\'; printf '\\033[34m%s\\n' '       /   /\\   \\' '      /   /  \\   \\' '     /   /    \\   \\' '    /   /      \\   \\'; printf '\\033[35m%s\\n' '   /   /   /\\   \\   \\' '  /   /   /  \\   \\   \\' ' /___/   /    \\   \\___\\'; printf '\\n\\033[34m    A R C H   L I N U X\\n\\033[36m       %s' \"$(uname -n)\"",
        "padding": {
            "top": 3,
            "left": 1,
            "right": 2
        },
        "position": "auto"
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "cyan"
        },
        "size": {
            "ndigits": 1
        },
        "bar": {
            "char": {
                "elapsed": "\u2501",
                "total": "\u2500"
            },
            "border": null,
            "width": 10,
            "color": {
                "elapsed": "cyan",
                "total": "bright_black"
            }
        },
        "percent": {
            "type": 3
        },
        "duration": {
            "abbreviation": true
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "{#bright_black}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
        },
        {
            "type": "custom",
            "format": "{#magenta}\u256d\u2500 SYSTEM {#bright_black}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
        },
        {
            "type": "os",
            "key": "\u2502 OS      ",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "\u2502 Kernel  ",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "\u2502 Uptime  "
        },
        {
            "type": "packages",
            "key": "\u2502 Packages",
            "format": "{all} installed"
        },
        {
            "type": "shell",
            "key": "\u2502 Shell   "
        },
        "break",
        {
            "type": "custom",
            "format": "{#magenta}\u251c\u2500 HARDWARE {#bright_black}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
        },
        {
            "type": "cpu",
            "key": "\u2502 CPU     ",
            "format": "{name} \u00b7 {cores-physical}C/{cores-logical}T"
        },
        {
            "type": "gpu",
            "key": "\u2502 GPU     ",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "\u2502 RAM     ",
            "format": "{percentage-bar} {used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "\u2502 Root    ",
            "folders": "/",
            "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "battery",
            "key": "│ Battery ",
            "format": "{capacity-bar} {capacity} · {status}"
        },
        "break",
        {
            "type": "custom",
            "format": "{#magenta}\u251c\u2500 DESKTOP {#bright_black}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
        },
        {
            "type": "wm",
            "key": "\u2502 WM      "
        },
        {
            "type": "terminal",
            "key": "\u2502 Terminal"
        },
        {
            "type": "custom",
            "format": "{#magenta}\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
        },
        {
            "type": "custom",
            "format": "{#cyan}\u25cf {#blue}\u25cf {#magenta}\u25cf {#green}\u25cf {#yellow}\u25cf {#red}\u25cf{#}"
        },
        "break"
    ]
}
